#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register Composer Autoloader
require __DIR__.'/vendor/autoload.php';

// Check if running artisan test command
$args = array_slice($argv, 1);
$command = $args[0] ?? null;

if ($command === 'test' && !in_array('--phpunit', $args)) {
    // Execute the Barangay Pianing Phase Test Suites
    $targetPhase = null;
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--phase=')) {
            $targetPhase = (int) substr($arg, 8);
        }
    }

    $startTime = microtime(true);
    require_once __DIR__ . '/tests/php/Phase1SecurityTest.php';
    require_once __DIR__ . '/tests/php/Phase2VerificationTest.php';
    require_once __DIR__ . '/tests/php/Phase3DocumentsTest.php';
    require_once __DIR__ . '/tests/php/Phase4HealthCenterTest.php';
    require_once __DIR__ . '/tests/php/Phase5GovernanceTest.php';

    $suites = [
        1 => ['title' => 'Tests\Phase1\EntryAndSecurityTest', 'class' => \Tests\Phase1\Phase1SecurityTest::class],
        2 => ['title' => 'Tests\Phase2\CivicIdentityVerificationTest', 'class' => \Tests\Phase2\Phase2VerificationTest::class],
        3 => ['title' => 'Tests\Phase3\CivilDocumentsStateMachineTest', 'class' => \Tests\Phase3\Phase3DocumentsTest::class],
        4 => ['title' => 'Tests\Phase4\CommunityHealthCenterTest', 'class' => \Tests\Phase4\Phase4HealthCenterTest::class],
        5 => ['title' => 'Tests\Phase5\GovernanceAndArchivalTest', 'class' => \Tests\Phase5\Phase5GovernanceTest::class],
    ];

    echo "\n   \033[44;37m BARANGAY PIANING MANAGEMENT SYSTEM \033[0m  \033[36mPhase Test Suite (Laravel Artisan)\033[0m\n\n";

    $totalPassed = 0;
    $totalFailed = 0;
    $totalAssertions = 0;

    foreach ($suites as $phaseNum => $suite) {
        if ($targetPhase !== null && $targetPhase !== $phaseNum) {
            continue;
        }

        $results = [];
        $suite['class']::run($results);

        $suitePassed = true;
        foreach ($results as $res) {
            if (!$res['pass']) {
                $suitePassed = false;
                break;
            }
        }

        if ($suitePassed) {
            echo "   \033[42;30m PASS \033[0m \033[1m{$suite['title']}\033[0m\n";
        } else {
            echo "   \033[41;37m FAIL \033[0m \033[1m{$suite['title']}\033[0m\n";
        }

        foreach ($results as $res) {
            $totalAssertions++;
            if ($res['pass']) {
                $totalPassed++;
                echo "  \033[32m✓\033[0m \033[90m{$res['name']}\033[0m\n";
            } else {
                $totalFailed++;
                echo "  \033[31m✗\033[0m \033[31m{$res['name']}\033[0m\n";
            }
        }
        echo "\n";
    }

    $duration = round(microtime(true) - $startTime, 2);
    echo "  \033[1mTests:\033[0m    " . ($totalFailed === 0 ? "\033[32m{$totalPassed} passed\033[0m" : "\033[31m{$totalFailed} failed\033[0m, \033[32m{$totalPassed} passed\033[0m") . " ({$totalAssertions} assertions)\n";
    echo "  \033[1mDuration:\033[0m {$duration}s\n\n";

    exit($totalFailed > 0 ? 1 : 0);
}

// Delegate all other commands to Laravel CLI
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';
$status = $app->handleCommand(new ArgvInput);
exit($status);
